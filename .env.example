# Copy to .env and adjust values. Never commit .env.
POSTGRES_USER=itsm
POSTGRES_PASSWORD=change_me
POSTGRES_DB=itsm_db

# Used when running the API outside Docker (uvicorn on your machine)
DATABASE_URL=postgresql+psycopg://itsm:change_me@localhost:5432/itsm_db
ENVIRONMENT=development

# JWT signing key (min 32 chars). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change_me_generate_a_long_random_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=30

# First admin account, created by: python -m app.scripts.create_admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_Admin123
ADMIN_FULL_NAME=System Administrator
